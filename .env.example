# Copie para .env e preencha.

# PostgreSQL (produção). Sem esta variável, o sistema usa PGlite local (desenvolvimento)
# e em produção recusa subir.
# DATABASE_URL=postgres://usuario:senha@host:5432/pedidos
# DB_POOL_MAX=5

# Pasta do banco local PGlite (opcional; padrão: ~/.pedidos-saas/pglite)
# PGLITE_DIR=

# Segredo para assinar a sessão (obrigatório em produção). Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Endereço público do site, usado nos links enviados pelo WhatsApp e no retorno do Mercado Pago.
SITE_URL=http://localhost:3010

# Usuário administrador da loja criado por `npm run db:seed`.
# Em produção deixe ADMIN_PASSWORD vazio: é gerada uma senha provisória com troca obrigatória.
ADMIN_EMAIL=admin@caixeta.local
ADMIN_PASSWORD=
